{
  "buildCommand": "npm install",
  "startCommand": "node server.js",
  "envVars": [
    {
      "key": "GEMINI_API_KEY",
      "value": "Add your Gemini API key here"
    },
    {
      "key": "NODE_ENV",
      "value": "production"
    },
    {
      "key": "PORT",
      "value": "5000"
    }
  ]
}
